+/// A tool implemented by the host page: `call(name, argumentsJson)` returns a Promise of
+/// `{ ok: boolean, text: string }`. The browser runtime is single-threaded, so the JS function is
+/// only ever touched on this thread (inside `spawn_local`).
+#[derive(Clone)]
+struct PageFn(Function);
+unsafe impl Send for PageFn {}
+unsafe impl Sync for PageFn {}
+
+struct PageTools {
+    specs: Vec<ToolSpec>,
+    call: PageFn,
+}
+impl Extension for PageTools {
+    fn id(&self) -> &str {
+        "page-tools"
+    }
+    fn tools(&self) -> Vec<Arc<dyn Tool>> {
+        self.specs
+            .iter()
+            .map(|spec| {
+                Arc::new(PageTool {
+                    spec: spec.clone(),
+                    call: self.call.clone(),
+                }) as Arc<dyn Tool>
+            })
+            .collect()
+    }
+}
+struct PageTool {
+    spec: ToolSpec,
+    call: PageFn,
+}
+#[async_trait::async_trait]
+impl Tool for PageTool {
+    fn spec(&self) -> ToolSpec {
+        self.spec.clone()
+    }
+    fn use_default_timeout(&self) -> bool {
+        false // page tools may load data on first use
+    }
+    async fn invoke(&self, arguments: serde_json::Value, _: ToolContext) -> Outcome {
+        let (tx, mut rx) = mpsc::channel::<(bool, String)>(1);
+        let call = self.call.clone();
+        let name = self.spec.name.clone();
+        let args = arguments.to_string();
+        spawn_local(async move {
+            let reply = async {
+                let value = call
+                    .0
+                    .call2(&JsValue::UNDEFINED, &JsValue::from_str(&name), &JsValue::from_str(&args))
+                    .map_err(|_| "page tool threw".to_string())?;
+                let value = JsFuture::from(js_sys::Promise::resolve(&value))
+                    .await
+                    .map_err(|e| e.as_string().unwrap_or_else(|| "page tool failed".into()))?;
+                let ok = Reflect::get(&value, &JsValue::from_str("ok"))
+                    .ok()
+                    .and_then(|v| v.as_bool())
+                    .unwrap_or(false);
+                let text = Reflect::get(&value, &JsValue::from_str("text"))
+                    .ok()
+                    .and_then(|v| v.as_string())
+                    .unwrap_or_default();
+                Ok::<_, String>((ok, text))
+            }
+            .await;
+            let _ = tx.send(reply.unwrap_or_else(|e| (false, e))).await;
+        });
+        match rx.recv().await {
+            Some((true, text)) => Outcome::Succeeded(text),
+            Some((false, text)) => Outcome::Failed(text),
+            None => Outcome::Failed("page tool dropped".into()),
+        }
+    }
+}
+
